{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"endOfLine": "lf",
	"insertFinalNewline": true,
	"useTabs": true,
	"printWidth": 80,
	"singleQuote": true,
	"trailingComma": "none",
	"semi": true,
	"ignorePatterns": ["index.html", "build/**"],
	"overrides": [
		{
			"files": ["*.yml"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}
