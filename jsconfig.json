{
	"compilerOptions": {
		"target": "ES2020",
		"module": "Node20",
		"moduleResolution": "Node16",
		"resolveJsonModule": true,
		"noEmit": true,
		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": false,
		"jsx": "react-jsx",
		"jsxImportSource": "preact"
	},
	"exclude": ["node_modules", "build"]
}
